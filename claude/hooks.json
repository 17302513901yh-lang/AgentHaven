{
  "description": "AgentHaven: brief each session on the board, refuse edits to files another agent has claimed, and ask for a progress report or handoff before going quiet on a task.",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/agenthaven.js\" hook session-start --agent claude-code", "timeout": 10 }] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/agenthaven.js\" hook pre-tool-use --agent claude-code", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/agenthaven.js\" hook stop --agent claude-code", "timeout": 10 }] }
    ]
  }
}
